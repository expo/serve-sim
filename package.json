{
  "name": "serve-sim-repo",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '@expo/serve-sim' dev",
    "check": "bun run lint && bun run typecheck",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "bun test --max-concurrency=1 packages/serve-sim/src/__tests__/ packages/serve-sim/scripts/tart/__tests__/",
    "test:e2e": "SERVE_SIM_E2E_REQUIRED=1 bun test --max-concurrency=1 packages/serve-sim/src/__tests__/ packages/serve-sim/scripts/tart/__tests__/"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^25.6.2",
    "knip": "^6.12.2",
    "oxlint": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
